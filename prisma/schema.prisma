generator client {
  provider = "prisma-client"
  output   = "generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  role      Role     @default(USER)
  createdAt DateTime @default(now())
}

enum Role {
  USER
  ADMIN
}

model Item {
  id          String        @id @default(uuid())
  tombamento  Int
  nome        String
  descricao   String?
  valor       Decimal
  categoria   Categoria
  marca       String
  quantidade  Int
  createdAt   DateTime      @default(now())

  unidades    UnidadeItem[]
}

model UnidadeItem {
  id             String         @id @default(uuid())
  estado         EstadoItem     @default(ATIVO)

  itemId         String
  item           Item           @relation(fields: [itemId], references: [id])

  ambienteId     String?
  ambiente       Ambiente?      @relation(fields: [ambienteId], references: [id])

  movimentacoes  Movimentacao[]

  createdAt      DateTime       @default(now())
}

model Ambiente {
  id          String        @id @default(uuid())
  name        String
  blocoId     String
  responsavel String

  bloco       Bloco         @relation(fields: [blocoId], references: [id])
  unidades    UnidadeItem[]

  @@unique([blocoId, name])
}

model Movimentacao {
  id             String      @id @default(uuid())
  unidadeItemId  String
  unidadeItem    UnidadeItem @relation(fields: [unidadeItemId], references: [id])

  origem         String
  destino        String
  resp           String

  dataMovimentacao DateTime @default(now())
}

enum EstadoItem {
  ATIVO
  EXTRAVIADO
  MANUTENÇÃO
  DANIFICADO
}

enum Categoria {
  ELETRÔNICO
  MÓVEIS
  MATERIAIS
  CLIMATIZAÇÃO
  HIGIENIZAÇÃO
  ESPORTE
}

model Bloco {
  id        String     @id @default(uuid())
  numero    Int?
  ambientes Ambiente[]
}